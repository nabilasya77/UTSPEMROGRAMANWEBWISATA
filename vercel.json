{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.0"
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/login.php" },
    { "src": "/home", "dest": "/api/home.php" },
    { "src": "/login", "dest": "/api/login.php" },
    { "src": "/admin", "dest": "/api/admin.dashboard.php" },
    { "src": "/(.*)", "dest": "/api/$1" }
  ]
}